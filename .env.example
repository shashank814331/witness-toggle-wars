# Client-side Flagsmith environment key (safe for Vite browser bundle).
# Use ONLY the Development environment key for local dev, tests, and sim/.
# Production builds must receive the Production environment key separately.
VITE_FLAGSMITH_ENV_KEY=

# Application environment label: development | production
VITE_APP_ENV=development

# Admin credentials (FLAGSMITH_API_KEY) must NEVER be placed in .env files.
# Authenticate via `npx flagsmith login` or export FLAGSMITH_API_KEY in your shell only.
