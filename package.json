{
  "name": "witness-toggle-wars-track01",
  "version": "0.1.0",
  "private": true,
  "description": "Witness: A pre-registered Flagsmith Experimentation lab testing counterexample vs count-only autograder feedback (Toggle Wars 2026, Track 01).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4511 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --maxWorkers=2",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@flagsmith/flagsmith": "^12.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@flagsmith/cli": "^2.0.0",
    "@playwright/test": "^1.50.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
